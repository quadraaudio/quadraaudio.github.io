;; Cloudflare DNS for Quadra Audio
;; Apex + www already on Cloudflare Pages (quadra-audio)
quadraaudio.com.	1	IN	AAAA	100:: ; cf_tags=cf-proxied:true
www.quadraaudio.com.	1	IN	CNAME	quadra-audio.pages.dev. ; cf_tags=cf-proxied:true

;; Visual editor subdomain → same Pages project
;; Also add "edit.quadraaudio.com" as a Custom Domain in Cloudflare Pages → quadra-audio
edit.quadraaudio.com.	1	IN	CNAME	quadra-audio.pages.dev. ; cf_tags=cf-proxied:true
