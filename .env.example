# App
APP_BASE_URL=http://localhost:3000

# Supabase (catalog + order/license storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional admin key (not required when STORE_FULFILLMENT_SECRET is set)
SUPABASE_SERVICE_ROLE_KEY=

# Must match public.store_secrets.fulfillment_secret (server-only)
STORE_FULFILLMENT_SECRET=

# Auth0 Regular Web Application + Google social connection
# Allowed Callback URL:  {APP_BASE_URL}/auth/callback
# Allowed Logout URL:    {APP_BASE_URL}
# Enable Google in Auth0 Authentication → Social → google-oauth2
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# PayPal (Orders v2) — sandbox while testing
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
