# App
APP_BASE_URL=http://localhost:3000

# Google sign-in (official Google Cloud OAuth)
# 1) https://console.cloud.google.com/apis/credentials
# 2) Create OAuth client → Web application
# 3) Authorized redirect URI:
#    http://localhost:3000/api/auth/callback/google
#    (and your live site URL + /api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Random secret for session cookies (any long random string):
AUTH_SECRET=

# Supabase (catalog + orders)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STORE_FULFILLMENT_SECRET=

# PayPal (optional until you test paid checkout)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
