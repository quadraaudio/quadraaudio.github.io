# App
APP_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required for order + license fulfillment (create/capture/free checkout, account reads).
# Without this key, checkout must fail honestly — never report a successful purchase.
SUPABASE_SERVICE_ROLE_KEY=

# Auth0 (Regular Web Application)
# Allowed Callback URL:  {APP_BASE_URL}/auth/callback
# Allowed Logout URL:    {APP_BASE_URL}
# Configure social / database connections in the Auth0 dashboard (Universal Login).
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
# Optional absolute app base for Auth0 SDK when behind a proxy:
# APP_BASE_URL=http://localhost:3000

# PayPal (Orders v2) — use sandbox credentials while testing
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox: https://api-m.sandbox.paypal.com | live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
