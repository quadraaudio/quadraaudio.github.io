# App
APP_BASE_URL=http://localhost:3000

# Supabase (required for auth, catalog, checkout fulfillment)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — only needed for admin scripts. Checkout uses fulfill_store_order RPC.
SUPABASE_SERVICE_ROLE_KEY=

# PayPal (Orders v2) — sandbox while testing
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox: https://api-m.sandbox.paypal.com | live: https://api-m.paypal.com
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
